{
    "workbench.colorCustomizations": {
        "focusBorder": "#00ff00",
        "foreground": "#00ff00",
        "widget.shadow": "#000000",
        "selection.background": "#00ff0040",
        "icon.foreground": "#00ff00",
        
        "window.activeBorder": "#00ff00",
        "window.inactiveBorder": "#003300",
        
        "titleBar.activeBackground": "#000000",
        "titleBar.activeForeground": "#00ff00",
        "titleBar.inactiveBackground": "#000000",
        "titleBar.inactiveForeground": "#008800",
        
        "activityBar.background": "#0a0a0a",
        "activityBar.foreground": "#00ff00",
        "activityBar.inactiveForeground": "#005500",
        "activityBarBadge.background": "#00ff00",
        "activityBarBadge.foreground": "#000000",
        
        "sideBar.background": "#050505",
        "sideBar.foreground": "#00cc00",
        "sideBar.border": "#00ff00",
        "sideBarTitle.foreground": "#00ff00",
        
        "list.activeSelectionBackground": "#00ff0033",
        "list.activeSelectionForeground": "#00ff00",
        "list.hoverBackground": "#00ff0011",
        
        "editor.background": "#000000",
        "editor.foreground": "#00ff00",
        "editorCursor.foreground": "#00ff00",
        "editorLineNumber.foreground": "#005500",
        "editorLineNumber.activeForeground": "#00ff00",
        
        "terminal.background": "#000000",
        "terminal.foreground": "#00ff00",
        "terminalCursor.foreground": "#00ff00",
        "terminal.ansiGreen": "#00ff00",
        
        "statusBar.background": "#000000",
        "statusBar.foreground": "#00ff00",
        "statusBar.border": "#00ff00"
    },
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": [
                    "comment",
                    "punctuation.definition.comment"
                ],
                "settings": {
                    "foreground": "#006600",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": [
                    "keyword",
                    "storage.type",
                    "storage.modifier"
                ],
                "settings": {
                    "foreground": "#39ff14",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": [
                    "string",
                    "punctuation.definition.string"
                ],
                "settings": {
                    "foreground": "#ccffcc"
                }
            },
            {
                "scope": [
                    "variable",
                    "entity.name.variable"
                ],
                "settings": {
                    "foreground": "#88ff88"
                }
            },
            {
                "scope": [
                    "constant.numeric",
                    "constant.language",
                    "constant.character"
                ],
                "settings": {
                    "foreground": "#00ffaa"
                }
            },
            {
                "scope": [
                    "entity.name.function",
                    "support.function"
                ],
                "settings": {
                    "foreground": "#55ff55",
                    "fontStyle": "bold"
                }
            }
        ]
    }
}
